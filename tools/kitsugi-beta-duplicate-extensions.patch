+package com.kitsugi.animelist.data.manga
+
+import java.io.File
+import java.util.Locale
+
+/** One APK and the source instances produced by its class loader. */
+internal data class LoadedMangaExtension<T>(
+    val path: String,
+    val packageName: String,
+    val versionCode: Long,
+    val sources: List<T>,
+)
+
+/**
+ * A legacy filename and a canonical package filename can both contain the same
+ * APK package. Pick the newest successfully loaded APK, independent of map or
+ * filesystem iteration order. Do not collapse distinct sources in one APK, or
+ * unrelated native extensions without a package name. This does not delete files.
+ */
+internal fun <T> preferredLoadedMangaSources(bundles: Collection<LoadedMangaExtension<T>>): List<T> {
+    val sorted = bundles.sortedWith(
+        compareByDescending<LoadedMangaExtension<T>> { it.versionCode }
+            .thenByDescending { bundle ->
+                bundle.packageName.isNotBlank() &&
+                    File(bundle.path).name == bundle.packageName.replace('.', '_') + ".apk"
+            }
+            .thenBy { it.path },
+    )
+    val seen = mutableSetOf<String>()
+    return sorted.flatMap { bundle ->
+        val key = bundle.packageName.trim().lowercase(Locale.ROOT)
+        if (key.isEmpty() || seen.add(key)) bundle.sources else emptyList()
+    }
+}
