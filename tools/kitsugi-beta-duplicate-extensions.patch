+package com.kitsugi.animelist.data.manga
+
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class LoadedMangaExtensionTest {
+    @Test
+    fun newestApkWinsRegardlessOfFilenameAndIterationOrder() {
+        val old = LoadedMangaExtension("/manga_extensions/tachiyomi-tr.merlinscans-v1.6.9.apk", "eu.kanade.merlin", 106009, listOf("old"))
+        val current = LoadedMangaExtension("/manga_extensions/eu_kanade_merlin.apk", "eu.kanade.merlin", 106011, listOf("new"))
+        assertEquals(listOf("new"), preferredLoadedMangaSources(listOf(old, current)))
+        assertEquals(listOf("new"), preferredLoadedMangaSources(listOf(current, old)))
+    }
+
+    @Test
+    fun equalVersionsPreferCanonicalFileAndPreserveAllSourcesInThatApk() {
+        val legacy = LoadedMangaExtension("/x/old.apk", "eu.test", 100, listOf("stale"))
+        val canonical = LoadedMangaExtension("/x/eu_test.apk", "eu.test", 100, listOf("a", "b"))
+        assertEquals(listOf("a", "b"), preferredLoadedMangaSources(listOf(legacy, canonical)))
+    }
+
+    @Test
+    fun independentPackagesAndUnidentifiedNativeFilesAreNotCollapsed() {
+        val entries = listOf(
+            LoadedMangaExtension("/a", "one", 5, listOf("one")),
+            LoadedMangaExtension("/b", "two", 5, listOf("two")),
+            LoadedMangaExtension("/c", "", -1, listOf("native1")),
+            LoadedMangaExtension("/d", "", -1, listOf("native2")),
+        )
+        assertEquals(listOf("one", "two", "native1", "native2"), preferredLoadedMangaSources(entries))
+    }
+}
