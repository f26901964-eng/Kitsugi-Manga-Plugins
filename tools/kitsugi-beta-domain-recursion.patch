+package com.kitsugi.animelist.data.manga
+
+import android.content.Context
+import android.content.SharedPreferences
+import org.junit.Assert.assertEquals
+import org.junit.Test
+import org.mockito.Mockito.`when`
+import org.mockito.Mockito.mock
+
+class SourceConfigRecursionTest {
+    @Test
+    fun configuredDomainDoesNotReadTheRecursiveBaseUrlGetter() {
+        val context = mock(Context::class.java)
+        val prefs = mock(SharedPreferences::class.java)
+        `when`(context.getSharedPreferences("manga_source_config", Context.MODE_PRIVATE)).thenReturn(prefs)
+        val source = mock(MangaSource::class.java)
+        val pkg = "eu.kanade.tachiyomi.extension.tr.merlinscans"
+        `when`(source.pkgName).thenReturn(pkg)
+        `when`(source.originalBaseUrl).thenReturn("https://merlintoon.com")
+        `when`(prefs.getString("$pkg::active_domain", null)).thenReturn("mirror.example")
+        val store = SourceConfigStore(context)
+        `when`(source.baseUrl).thenAnswer { store.getPreferredBaseUrl(source, source.originalBaseUrl) }
+        assertEquals("https://mirror.example", source.baseUrl)
+    }
+}
